# Copy this file to .env when we begin the Photon 2.0 runtime integration.
# Keep these values server-side; never commit .env or paste keys into chat.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# Needed for the proposed Photon SIP → LiveKit voice-agent route.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Only if the project chooses the legacy spectrum-ts SDK instead of Photon 2.0 API:
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
