# Worker secrets. Configure in DeepSpace's secret store for production or in
# Product/deepspace-host/.dev.vars for local development. Never expose them in
# browser JavaScript, commit .env/.dev.vars, or paste secret values into chat.
PHAROS_RESPONDER_PASSWORD=
PHAROS_COORDINATOR_PASSWORD=
PHAROS_SESSION_SECRET=
PHAROS_INGEST_TOKEN=
PHAROS_TRANSCRIPT_RETENTION_HOURS=24

# Set the route-ready flag only after the Photon SIP → LiveKit test call works.
PHAROS_VOICE_ROUTE_READY=false
PHOTON_VOICE_LINE_ID=
LIVEKIT_URL=

# Agent-only values belong in Product/voice-agent/.env.local instead.
# That file needs the LiveKit API key and secret plus the same PHAROS_INGEST_TOKEN.

# Optional Photon HTTP API credentials are not used by the current SIP → LiveKit path.
# Do not add them unless a future feature calls Photon HTTP APIs directly.
