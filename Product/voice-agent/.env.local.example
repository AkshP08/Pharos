# Copy to .env.local and keep the real file untracked.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# This must be the deployed Pharos app URL and match its server-side secret.
PHAROS_API_URL=https://signalbridge-hackutd-2026.app.space
PHAROS_INGEST_TOKEN=

# LiveKit Inference uses LiveKit Cloud credentials for these model calls.
PHAROS_STT_MODEL=deepgram/nova-3
PHAROS_LLM_MODEL=google/gemma-4-31b-it
PHAROS_TTS_MODEL=fishaudio/s2.1-pro
PHAROS_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
LOG_LEVEL=INFO

# The same runtime supports two isolated call experiences. Use the matching
# agent name in your LiveKit dispatch rule; do not dispatch both into one room.
PHAROS_CALL_MODE=intake
PHAROS_AGENT_NAME=pharos-intake
PHAROS_TEST_CALLER_NUMBERS=
PHAROS_ALLOW_BROWSER_TESTS=false
PHAROS_MAX_CALL_SECONDS=180

# Optional guard mode. Only enable after reviewing the two-leg call costs and
# obtaining both teammates' consent. Keep these phone numbers private.
PHAROS_ENABLE_GUARD_RELAY=false
PHAROS_GUARD_RESIDENT_CONSENTED=false
PHAROS_GUARD_RESIDENT_NUMBER=
PHAROS_GUARD_ALLOWED_CALLERS=
LIVEKIT_OUTBOUND_TRUNK_ID=
PHAROS_GUARD_MAX_SECONDS=300
# Guard-only caller-context review; at most eight bounded reviews per call.
# Failure is reported as unavailable, without a keyword/regex substitute.
PHAROS_SEMANTIC_GUARD_REVIEW=true
